    {
      "SurveyID": "SV_AI_Text_Ranking_2x2x2",
      "Element": "SQ",
      "PrimaryAttribute": "QID_A1",
      "SecondaryAttribute": "Rank the 4 News texts by human-likeness (1 = most human-like … 4 = least). No ties.",
      "TertiaryAttribute": "1",
      "Payload": {
        "QuestionText": "Rank the 4 News texts by human-likeness (1 = most human-like … 4 = least). No ties.",
        "DefaultChoices": false,
        "DataExportTag": "QID_A1",
